{
  "name": "ingec-platform",
  "version": "1.0.0",
  "description": "INGEC Integration Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start:server": "npm run start --workspace=server",
    "start:client": "npm run dev --workspace=client",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
